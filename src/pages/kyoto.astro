---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SpotCard from "../components/SpotCard.astro";
import DiscoverList from "../components/DiscoverList.astro";
import ParkingGrid from "../components/ParkingGrid.astro";
import TipsList from "../components/TipsList.astro";
import AdSlot from "../components/AdSlot.astro";
import heroImg from "../assets/photos/kyoto-apit-auto-mur-volants.jpg";
import { kyotoIntro, kyotoSpots, kyotoDiscover, kyotoParking, kyotoTips } from "../data/kyoto";
---

<Layout
  title="Kyoto"
  description="A PIT Autobacs, Liberty Walk et stationnement près des temples : le guide du passionné d'automobile à Kyoto."
>
  <Hero
    image={heroImg}
    eyebrow="Destination"
    title="Kyoto"
    subtitle="Entre les temples, quelques-unes des adresses les plus respectées du milieu JDM au Japon."
  />

  <section class="mx-auto max-w-4xl px-5 py-10 sm:py-14 sm:px-8">
    <p class="reveal font-body text-lg leading-relaxed text-ink-soft">{kyotoIntro}</p>
  </section>

  <section class="mx-auto max-w-8xl px-5 pb-10 sm:pb-14 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="Bonne adresse" title="Le temple des passionnés" />
        <div class="mt-10 grid gap-6">
          {kyotoSpots.map((spot) => <SpotCard spot={spot} />)}
        </div>
      </div>
      <div>
        <SectionHeading
          eyebrow="À découvrir"
          title="Repérée pour mon prochain voyage"
          description="Je n'ai pas eu le temps d'y aller, mais tout ce que j'en ai vu en ligne donne envie. Je la compléterai avec mes photos et mon avis."
        />
        <div class="mt-10">
          <DiscoverList items={kyotoDiscover} gridClass="" />
        </div>
      </div>
    </div>
  </section>

  <AdSlot class="py-8 sm:py-12" />

  <section class="border-t border-mist-200 bg-paper-dim/50 py-12 sm:py-16">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <SectionHeading eyebrow="Où se garer" title="Stationnement près des temples" />
          <div class="mt-8">
            <ParkingGrid items={kyotoParking} />
          </div>
        </div>
        <div>
          <SectionHeading eyebrow="Conseils" title="Pour en profiter au maximum" />
          <div class="mt-8">
            <TipsList tips={kyotoTips} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
