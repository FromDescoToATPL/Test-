---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../consts";
// Une seule page 404 pour tout le site : le texte est donc dans les deux langues.
---

<Layout title="Page introuvable">
  <section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-5 text-center sm:px-8">
    <p class="eyebrow text-racing-500">Erreur 404</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink">Mauvaise sortie d'autoroute</h1>
    <p class="mt-4 font-body text-base leading-relaxed text-ink-soft">
      Cette page n'existe pas (ou plus). Fais demi-tour au prochain péage.
    </p>
    <p class="mt-2 font-body text-sm leading-relaxed text-mist-500" lang="en">
      Wrong exit: this page doesn't exist (anymore). Turn around at the next toll gate.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={withBase("/")}
        class="inline-flex items-center gap-2 rounded-md bg-ink px-5 py-3 font-body text-sm font-medium text-paper transition-colors hover:bg-racing-600"
      >
        Retour à l'accueil
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a
        href={withBase("/en/")}
        lang="en"
        class="inline-flex items-center gap-2 rounded-md border border-mist-300 px-5 py-3 font-body text-sm font-medium text-ink transition-colors hover:border-ink"
      >
        Back to home
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>
</Layout>
