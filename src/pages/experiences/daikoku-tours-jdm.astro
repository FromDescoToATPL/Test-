---
// Article « Daikoku PA : y aller seul ou avec un tour JDM ? ». Clément n'y est pas allé (météo) : tout est vérifié
// en ligne le 04/11/2026, sources en commentaire à côté de chaque fait. Offres dans src/data/offres.ts.
// Mise en page : une seule colonne (max-w-3xl), texte limité à ~66 caractères par ligne, sections espacées de façon
// régulière ; chaque façon d'y aller se termine par sa ligne « prix + bouton » (EncartReserver variante="ligne").
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import PageToc from "../../components/PageToc.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import EncartReserver from "../../components/EncartReserver.astro";
import MentionAffiliation from "../../components/MentionAffiliation.astro";
import { withBase } from "../../consts";
import heroImg from "../../assets/photos/tokyo-nuit-rx7-veilside.jpg";

const offresPage = [
  "onlyjdm-location",
  "daikoku-gyg-car-culture",
  "daikoku-gyg-tokyo-turismo",
  "daikoku-klook-nuit",
  "daikoku-klook-au-volant",
  "onlyjdm-klook-tour-daikoku",
];
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Daikoku Futo Parking Area, Yokohama")}`;

const h2 = "reveal text-balance font-display text-2xl font-semibold text-ink sm:text-3xl";
const texte = "reveal mt-4 max-w-[66ch] space-y-4 font-body text-base leading-relaxed text-ink-soft";
const lien = "link-underline font-medium text-racing-500";

// Les tours en passager, du plus conseillé au moins cher. Sources en commentaire dans le gabarit, plus bas.
const toursPassager = [
  {
    id: "daikoku-gyg-tokyo-turismo",
    titre: "Tokyo Drift III, par Tokyo Turismo",
    infos: "GetYourGuide · 4,8/5 sur plus de 6 300 avis · 3 à 4 h",
    texte:
      "La plus réservée. Vous montez dans une vraie voiture de sport : leur flotte compte des Skyline R34, des GT-R R35, des Evo, une Chaser de drift… On est trois ou quatre par voiture, on ne choisit pas laquelle, mais on vous ramène à votre hôtel dans le centre de Tokyo.",
  },
  {
    id: "daikoku-gyg-car-culture",
    titre: "Daikoku et ambiance Tokyo Drift",
    infos: "GetYourGuide · 4,8/5 sur 725 avis · 3 h",
    texte:
      "La moins chère. Petit groupe de 10 personnes maximum, à bord d'un van ou d'une sportive selon l'option, avec un arrêt chez A PIT Autobacs. En anglais.",
  },
  {
    id: "daikoku-klook-nuit",
    titre: "Visite nocturne JDM avec guide local",
    infos: "Klook · 4,9/5 sur plus de 2 300 avis · 2 h 30 à 3 h",
    texte: "En voiture JDM, avec une formule classique et une formule VIP.",
  },
  {
    // source : Klook activité 161862 (départ de l'agence OnlyJDM de Haneda, même adresse que celle où Clément a loué
    // son Evo), 3 h 30, 2 à 9 personnes, 182 € par personne, pas d'avis affichés, vérifié le 04/11/2026
    id: "onlyjdm-klook-tour-daikoku",
    titre: "Le tour d'OnlyJDM, au départ de leur agence",
    infos: "Klook · 3 h 30 · de 2 à 9 personnes",
    texte:
      "L'agence où j'ai loué mon Evo organise aussi son propre tour. Rendez-vous à 16 h 30 à l'agence, près de Haneda, puis un chauffeur vous emmène à Daikoku, dans un Super Autobacs et sur le Rainbow Bridge, avant de vous déposer à la Tokyo Tower. Les voitures changent selon le stock : GR86, GR Yaris, Civic Type R ou Evo X. C'est le plus cher des quatre, 182 € par personne avec 2 personnes minimum, et il n'a pas encore d'avis sur Klook.",
  },
];

const pieges = [
  {
    titre: "Les soirs de fermeture",
    texte: "Le vendredi et le samedi soir, gardez en tête les fermetures et vérifiez le plan B de votre tour.",
  },
  {
    // source : GetYourGuide t794698 et t1460635 (le nombre de voitures dépend de la météo), vérifié le 04/11/2026
    titre: "La pluie",
    texte:
      "Les organisateurs le disent eux-mêmes : le nombre de voitures dépend de la météo. Un soir de pluie, le parking peut être presque vide. Je suis bien placé pour vous en parler…",
  },
  {
    // source : Klook activité 110547 (adhésion à un club, trajet, voiture et Daikoku non garantis), vérifié le 04/11/2026
    titre: "Les petites lignes",
    texte:
      "Sur les plateformes, certaines offres très populaires sont en fait une adhésion à un club : leurs conditions précisent que le trajet, la voiture et même le passage à Daikoku ne sont pas garantis. Lisez la description jusqu'au bout avant de payer.",
  },
  {
    // source : GetYourGuide t560550 (ne pas toucher, s'appuyer ou s'asseoir sur les voitures), vérifié le 04/11/2026
    titre: "Les voitures des autres",
    texte:
      "On ne touche pas, on ne s'appuie pas, on ne s'assoit pas dessus. Pour une photo de près, demandez au propriétaire : la plupart sont ravis d'en parler.",
  },
  {
    // source : GetYourGuide t560550 et t794698 (« À emporter : passeport ou pièce d'identité »), vérifié le 04/11/2026
    titre: "Votre passeport",
    texte: "Les organisateurs le demandent : gardez-le sur vous.",
  },
];

const faq = [
  {
    q: "Peut-on aller à Daikoku en train ou à pied ?",
    r: "Non. L'aire se trouve sur l'autoroute urbaine : il faut une voiture, que ce soit la vôtre, celle d'un tour ou un taxi. Et le taxi, je ne vous le conseille pas : rien ne garantit d'en trouver un sur place pour repartir.",
  },
  {
    q: "Quel soir aller à Daikoku ?",
    r: "Le week-end, c'est là qu'il y a le plus de voitures, mais aussi le plus de fermetures, surtout le vendredi et le samedi soir. En semaine, c'est plus calme : moins de monde, mais moins de risque de trouver l'entrée fermée.",
  },
  {
    q: "Combien coûte un tour à Daikoku ?",
    r: "Comptez à partir de 71 € en passager dans un petit groupe, environ 120 € pour monter dans une voiture de sport, et à partir de 467 € pour conduire vous-même. Prix relevés le 4 novembre 2026.",
  },
  {
    q: "Faut-il un permis pour faire un tour ?",
    r: "Pas si vous êtes passager : le passeport suffit. Pour conduire, il faut votre permis physique, la traduction officielle de votre permis français, et, pour l'offre que j'ai trouvée, 21 ans et 3 ans de permis minimum.",
  },
  {
    q: "Que faire si Daikoku est fermé ?",
    r: "Tatsumi PA, plus proche du centre de Tokyo, et Umihotaru PA, au milieu de la baie, sont les plans B classiques. Le magasin A PIT Autobacs de Shinonome reste aussi ouvert tard. Les tours sérieux s'adaptent d'eux-mêmes.",
  },
];

const infosPratiques = [
  { label: "Où", valeur: "Aire de repos de l'autoroute urbaine Shuto, à Yokohama (quartier de Tsurumi)" },
  { label: "Accès", valeur: "En voiture uniquement, entrée libre" },
  { label: "Quand", valeur: "Le soir, surtout le week-end, sans horaire ni programme" },
  { label: "Fermetures", valeur: "Fréquentes le vendredi et le samedi soir, et en cas de fortes chutes de neige" },
  { label: "Plans B", valeur: "Tatsumi PA, Umihotaru PA, A PIT Autobacs Shinonome" },
];
---

<Layout
  title="Daikoku PA : quel tour JDM réserver, ou y aller seul ?"
  description="Daikoku PA ne s'atteint qu'en voiture. Tour en passager, au volant ou location : prix vérifiés, fermetures du week-end et mon conseil pour choisir."
  article={{ published: "2026-11-04" }}
  breadcrumbs={[
    { name: "Expériences", path: "/experiences/" },
    { name: "Daikoku PA", path: "/experiences/daikoku-tours-jdm/" },
  ]}
>
  <Hero
    image={heroImg}
    eyebrow="Expériences · Yokohama"
    title="Daikoku PA : y aller seul ou avec un tour JDM ?"
    subtitle="Le rassemblement le plus célèbre du Japon ne s'atteint qu'en voiture. Voici comment choisir."
    focalPoint="50% 62%"
  />

  <div class="mx-auto max-w-3xl space-y-12 px-5 pt-10 pb-12 sm:space-y-14 sm:px-8 sm:pt-14 sm:pb-16">
    <div>
      <a
        href={withBase("/experiences/")}
        class="tap-target link-underline reveal inline-flex items-center gap-1.5 font-body text-sm font-medium text-ink-soft"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        Toutes les expériences
      </a>

      <MentionAffiliation ids={offresPage} class="mt-6" />

      <p class="reveal mt-8 max-w-[62ch] font-body text-lg leading-relaxed text-ink">
        Daikoku, c'est le parking d'autoroute le plus célèbre du Japon. Le soir, des passionnés y garent leurs JDM,
        leurs supercars et leurs projets les plus fous, juste pour discuter et se montrer. Le hic : on n'y entre qu'en
        voiture, par l'autoroute urbaine. Si vous louez déjà une JDM, allez-y vous-même, c'est le plus libre et le
        moins cher. Sinon, un tour en passager reste la solution la plus simple, à partir d'environ 70 €.
      </p>
      <p class="reveal mt-4 max-w-[66ch] font-body text-base leading-relaxed text-ink-soft">
        Je vais être honnête avec vous : je n'ai pas pu y aller pendant mon voyage, la météo en a décidé autrement. J'ai
        donc fait mes devoirs pour le prochain : sites des organisateurs, conditions, avis des voyageurs. Tout ce que
        vous lisez ici a été vérifié le 4 novembre 2026.
      </p>
      <p class="reveal mt-3 font-body text-xs text-mist-500">
        En photo : la RX-7 VeilSide de Tokyo Drift, croisée un soir dans Tokyo. Pas à Daikoku, donc.
      </p>

      <PageToc
        items={[
          { label: "Fermetures", href: "#fermetures" },
          { label: "Comparatif", href: "#comparatif" },
          { label: "Location", href: "#location" },
          { label: "Passager", href: "#passager" },
          { label: "Au volant", href: "#au-volant" },
          { label: "Pièges", href: "#pieges" },
          { label: "FAQ", href: "#faq" },
        ]}
      />
    </div>

    <section id="cest-quoi" class="scroll-mt-20">
      <h2 class={h2}>Daikoku, c'est quoi exactement ?</h2>
      <div class={texte}>
        {/* source : https://kuruma-news.jp/post/99236 (PA sur l'autoroute Shuto, toilettes et boutiques), vérifié le 04/11/2026 */}
        <p>
          Daikoku PA (pour « parking area ») est une aire de repos posée au milieu d'un énorme échangeur, à Yokohama, sur
          l'autoroute urbaine de Tokyo, la Shuto. En journée, c'est un arrêt banal : des toilettes, quelques boutiques,
          des voyageurs de passage. Le soir, et surtout le week-end, l'ambiance n'a plus rien à voir. Skyline, Supra,
          RX-7, Lamborghini, voitures bosozoku : chacun vient avec ce qu'il a de plus beau.
        </p>
        <p>
          Il faut bien comprendre une chose : ce n'est pas un événement. Il n'y a ni billet, ni horaire, ni programme.
          Certains soirs, le parking déborde ; d'autres, il pleut et il n'y a presque personne. C'est ce qui fait son
          charme, et c'est aussi pour ça qu'il vaut mieux savoir où l'on met les pieds avant de payer un tour.
        </p>
      </div>
    </section>

    <section id="fermetures" class="scroll-mt-20">
      <div class="reveal rounded-lg border border-racing-500/30 bg-racing-500/5 p-5 sm:p-7">
        <h2 class="flex items-center gap-2.5 text-balance font-display text-xl font-semibold text-ink sm:text-2xl">
          <Icon name="flag" class="h-5 w-5 shrink-0 text-racing-500" />
          Le piège : les fermetures du week-end
        </h2>
        <p class="mt-2 font-body text-base leading-relaxed text-ink-soft">C'est le point que beaucoup découvrent sur place.</p>
        <dl class="mt-4 divide-y divide-racing-500/15 border-t border-racing-500/15 font-body text-sm leading-relaxed">
          {/* source : https://kuruma-news.jp/post/99236 (fermeture le samedi soir quand les voitures modifiées affluent, réouverture vers 1 h - 3 h), vérifié le 04/11/2026. À VÉRIFIER : article ancien, la pratique peut avoir changé. */}
          {/* source : fiche GetYourGuide t560550 (« fermée du vendredi au samedi, de 19 h 30 à 2 h »), vérifié le 04/11/2026. À VÉRIFIER */}
          <div class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-5">
            <dt class="font-semibold text-ink">Vendredi et samedi soir</dt>
            <dd class="text-ink-soft">
              Quand trop de voitures modifiées s'y retrouvent, l'accès est coupé et tout le monde doit repartir.
              D'après la presse auto japonaise, la réouverture se fait en général entre 1 h et 3 h du matin. Un
              organisateur de tours indique même que l'aire est fermée de 19 h 30 à 2 h ces soirs-là.
            </dd>
          </div>
          {/* source : https://www.shutoko.jp/news/2025/12/01-closure/ (fermeture en cas de fortes chutes de neige annoncées), vérifié le 04/11/2026 */}
          <div class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-5">
            <dt class="font-semibold text-ink">Fortes chutes de neige</dt>
            <dd class="text-ink-soft">
              Le gestionnaire de l'autoroute ferme l'aire quand elles sont annoncées : elle sert alors de base pour le
              déneigement.
            </dd>
          </div>
          <div class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-5">
            <dt class="font-semibold text-ink">Le plan B</dt>
            <dd class="text-ink-soft">
              Pas de panique : les bons tours en ont un, en général Tatsumi PA ou le magasin A PIT Autobacs de
              Shinonome. Vérifiez simplement que le vôtre le prévoit.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="comparatif" class="scroll-mt-20">
      <h2 class={h2}>Les trois façons d'y aller</h2>
      <p class="reveal mt-4 max-w-[66ch] font-body text-base leading-relaxed text-ink-soft">
        Tout dépend d'une question : est-ce que vous louez déjà une voiture pendant votre séjour ?
      </p>
      <ComparisonTable
        class="mt-6"
        caption="Comparatif des trois façons d'aller à Daikoku PA"
        rowHeader="Façon d'y aller"
        columns={[
          { key: "prix", label: "Prix indicatif", emphasis: true },
          { key: "duree", label: "Durée" },
          { key: "role", label: "Vous êtes" },
          { key: "annulation", label: "Annulation" },
        ]}
        rows={[
          {
            title: "En location",
            values: {
              prix: "27 000 ¥ les 7 h chez OnlyJDM, plus essence et péages",
              duree: "7 h ou 24 h",
              role: "Au volant, libre",
              annulation: "Selon l'agence",
            },
          },
          {
            title: "Tour en passager",
            values: {
              prix: "À partir de 71 €",
              duree: "2 h 30 à 4 h",
              role: "Passager, en petit groupe ou en privé",
              annulation: "Gratuite jusqu'à 24 h avant sur GetYourGuide",
            },
          },
          {
            title: "Tour au volant",
            values: {
              prix: "À partir de 467 €",
              duree: "4 h",
              role: "Au volant, derrière une voiture guide",
              annulation: "Selon l'offre",
            },
          },
        ]}
        note="Prix relevés le 4 novembre 2026 : ils changent selon la date et l'option choisie."
      />
    </section>

    <section id="location" class="scroll-mt-20">
      <h2 class={h2}>Vous louez déjà une JDM ? Allez-y vous-même</h2>
      <div class={texte}>
        <p>
          C'est ce que j'aurais fait avec <a href={withBase("/tokyo/only-jdm/")} class={lien}>mon Evo VIII de chez OnlyJDM</a> si
          le ciel avait été plus clément. Une fois au volant, Daikoku n'est qu'une sortie d'autoroute : vous arrivez
          quand vous voulez, vous restez le temps que vous voulez, et vous pouvez enchaîner avec Tatsumi ou Umihotaru
          dans la même soirée.
        </p>
        <p>
          Trois choses à prévoir : la traduction officielle de votre permis (sans elle, pas de location), idéalement une
          carte ETC pour les péages, et un peu de patience pour trouver une place les soirs d'affluence. Tout est
          détaillé sur ma page <a href={withBase("/conduire-au-japon/")} class={lien}>Conduire au Japon</a>. Et sur
          place, on reste cool : pas de rupteur, pas de burn, on se gare et on profite. C'est aussi grâce à ça que
          l'endroit existe encore.
        </p>
      </div>
      <EncartReserver ids={["onlyjdm-location"]} variante="ligne" class="mt-6" />
    </section>

    <section id="passager" class="scroll-mt-20">
      <h2 class={h2}>Le plus simple : un tour en passager</h2>
      <div class={texte}>
        <p>
          Si vous ne louez pas de voiture, c'est la solution logique. Un guide vous emmène, gère la route et les péages,
          et connaît les plans B quand Daikoku est fermé. Trois offres sortent clairement du lot, plus une quatrième que je ne
          pouvais pas laisser de côté.
        </p>
        <p>
          Si je devais réserver demain pour une première fois, je prendrais Tokyo Turismo : aller à Daikoku assis dans
          une GT-R, ça fait partie du rêve. Si le budget compte, le tour à 71 € fait très bien le travail pour une
          cinquantaine d'euros de moins.
        </p>
      </div>

      {/* sources :
          GetYourGuide t794698 (Tokyo Turismo), 4,8/5 (6 309 avis), 3 à 4 h, flotte de 40 voitures, 3 à 4 par voiture, retour à l'hébergement, 121 €, vérifié le 04/11/2026
          GetYourGuide t560550, 4,8/5 (725 avis), 3 h, 10 personnes max, A PIT Autobacs, anglais, 71 €, vérifié le 04/11/2026
          Klook activité 137151, 4,9/5 (2,3k avis), 2 h 30 à 3 h, formule classique ou VIP, 119 €, vérifié le 04/11/2026 */}
      <div class="mt-6 divide-y divide-mist-200 border-y border-mist-200">
        {toursPassager.map((tour) => (
          <div class="py-6">
            <h3 class="reveal text-balance font-display text-xl font-semibold text-ink">{tour.titre}</h3>
            <p class="reveal mt-1 font-body text-sm text-mist-500">{tour.infos}</p>
            <p class="reveal mt-3 max-w-[66ch] font-body text-base leading-relaxed text-ink-soft">{tour.texte}</p>
            <EncartReserver ids={[tour.id]} variante="ligne" class="mt-4" />
          </div>
        ))}
      </div>
    </section>

    <section id="au-volant" class="scroll-mt-20">
      <h2 class={h2}>Le plus fou : conduire une JDM jusqu'à Daikoku</h2>
      <div class={texte}>
        {/* source : Klook activité 147074 (4 h, 80 km, voiture guide, carburant et péages inclus, 21 ans, 3 ans de permis, permis physique + passeport + traduction japonaise pour la France), 467 €, vérifié le 04/11/2026 */}
        <p>
          Sur Klook, une offre vous met au volant d'une JDM pendant quatre heures, derrière une voiture guide : environ
          80 km, avec un arrêt chez A PIT Autobacs, le rassemblement de Daikoku, le passage sur le Rainbow Bridge et
          des photos à la Tokyo Tower. Carburant et péages compris.
        </p>
        <p>
          Les conditions sont strictes : 21 ans minimum, 3 ans de permis, et votre permis physique avec le passeport et
          la traduction japonaise officielle (la France fait partie des pays concernés). Pas de copie, pas de version
          numérique.
        </p>
        <p>
          C'est cher : à partir de 467 €. Pour comparer, OnlyJDM loue l'Evo VIII 30 000 ¥ les 24 h, et vous gardez la
          voiture toute la journée. Le vrai plus du tour, c'est de ne gérer ni la route, ni le stationnement.
        </p>
      </div>
      <EncartReserver ids={["daikoku-klook-au-volant"]} variante="ligne" class="mt-6" />
    </section>

    <section id="pieges" class="scroll-mt-20">
      <h2 class={h2}>Les pièges à éviter</h2>
      <ul class="mt-5 space-y-5">
        {pieges.map((p) => (
          <li class="reveal max-w-[66ch]">
            <p class="font-body text-base font-semibold text-ink">{p.titre}</p>
            <p class="mt-1 font-body text-base leading-relaxed text-ink-soft">{p.texte}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq" class="scroll-mt-20">
      <h2 class={h2}>Questions fréquentes</h2>
      <div class="reveal mt-5 divide-y divide-mist-200 border-y border-mist-200">
        {faq.map((item) => (
          <details class="group">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-ink transition-colors hover:text-racing-500 [&::-webkit-details-marker]:hidden">
              <h3 class="font-display text-lg font-semibold">{item.q}</h3>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-mist-500 transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <p class="max-w-[66ch] pb-5 font-body text-base leading-relaxed text-ink-soft">{item.r}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="reveal rounded-lg border border-mist-200 bg-paper-dim/40 p-5 sm:p-6">
      <p class="eyebrow text-racing-500">Infos pratiques</p>
      <p class="mt-2 font-display text-lg font-semibold text-ink">Daikoku PA</p>
      <dl class="mt-3 space-y-2 font-body text-sm leading-relaxed">
        {infosPratiques.map((info) => (
          <div class="grid grid-cols-[6.5rem_1fr] gap-3">
            <dt class="font-medium text-ink">{info.label}</dt>
            <dd class="text-ink-soft">{info.valeur}</dd>
          </div>
        ))}
      </dl>
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="tap-target link-underline mt-3 inline-flex items-center gap-1.5 font-body text-sm font-medium text-racing-500"
      >
        Ouvrir dans Google Maps
        <Icon name="external-link" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-10 sm:py-14">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <p class="eyebrow text-mist-500">À lire aussi</p>
      <ul class="mt-4 grid gap-x-8 sm:grid-cols-2">
        {[
          { label: "Mes adresses à Tokyo", href: withBase("/tokyo/") },
          { label: "Où rouler à Tokyo", href: withBase("/tokyo/ou-rouler/") },
          { label: "Ma location chez OnlyJDM", href: withBase("/tokyo/only-jdm/") },
          { label: "Louer une JDM au Japon", href: withBase("/louer-une-voiture/") },
          { label: "Conduire au Japon", href: withBase("/conduire-au-japon/") },
          { label: "Toutes les expériences", href: withBase("/experiences/") },
        ].map((l) => (
          <li>
