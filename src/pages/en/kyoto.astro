---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SpotCard from "../../components/SpotCard.astro";
import DiscoverList from "../../components/DiscoverList.astro";
import ParkingGrid from "../../components/ParkingGrid.astro";
import TipsList from "../../components/TipsList.astro";
import AdSlot from "../../components/AdSlot.astro";
import heroImg from "../../assets/photos/kyoto-apit-auto-mur-volants.jpg";
import { kyotoIntro, kyotoSpots, kyotoDiscover, kyotoParking, kyotoTips } from "../../data/en/kyoto";
---

<Layout
  title="Kyoto"
  description="A PIT Autobacs, Liberty Walk and parking near the temples: the car enthusiast's guide to Kyoto."
>
  <Hero
    image={heroImg}
    eyebrow="Destination"
    title="Kyoto"
    subtitle="Between the temples, some of the most respected spots in the JDM scene in Japan."
  />

  <section class="mx-auto max-w-4xl px-5 py-10 sm:py-14 sm:px-8">
    <p class="reveal font-body text-lg leading-relaxed text-ink-soft">{kyotoIntro}</p>
  </section>

  <section class="mx-auto max-w-8xl px-5 pb-10 sm:pb-14 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="Where to go" title="The enthusiasts' temple" />
        <div class="mt-10 grid gap-6">
          {kyotoSpots.map((spot) => <SpotCard spot={spot} />)}
        </div>
      </div>
      <div>
        <SectionHeading
          eyebrow="To discover"
          title="Spotted for my next trip"
          description="I didn't have time to go, but everything I've seen of it online makes me want to. I'll complete it with my photos and my review."
        />
        <div class="mt-10">
          <DiscoverList items={kyotoDiscover} gridClass="" />
        </div>
      </div>
    </div>
  </section>

  <AdSlot class="py-8 sm:py-12" />

  <section class="border-t border-mist-200 bg-paper-dim/50 py-12 sm:py-16">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <SectionHeading eyebrow="Where to park" title="Parking near the temples" />
          <div class="mt-8">
            <ParkingGrid items={kyotoParking} />
          </div>
        </div>
        <div>
          <SectionHeading eyebrow="Tips" title="Make the most of it" />
          <div class="mt-8">
            <TipsList tips={kyotoTips} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
