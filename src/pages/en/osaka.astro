---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SpotCard from "../../components/SpotCard.astro";
import DiscoverList from "../../components/DiscoverList.astro";
import ParkingGrid from "../../components/ParkingGrid.astro";
import TipsList from "../../components/TipsList.astro";
import AdSlot from "../../components/AdSlot.astro";
import heroImg from "../../assets/photos/osaka-meetup-mx5-nuit.jpg";
import { osakaIntro, osakaSpots, osakaDiscover, osakaParking, osakaTips } from "../../data/en/osaka";
---

<Layout
  title="Osaka"
  description="Liberty Walk stores, late-night car meets, parking and great spots for car enthusiasts passing through Osaka."
>
  <Hero
    image={heroImg}
    eyebrow="Destination"
    title="Osaka"
    subtitle="The street energy of Kansai, and a few cult spots to bring home more than a memory of Dotonbori."
  />

  <section class="mx-auto max-w-4xl px-5 py-10 sm:py-14 sm:px-8">
    <p class="reveal font-body text-lg leading-relaxed text-ink-soft">{osakaIntro}</p>
  </section>

  <section class="mx-auto max-w-8xl px-5 pb-12 sm:pb-16 sm:px-8">
    <SectionHeading eyebrow="Where to go" title="Shopping & car meets" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {osakaSpots.map((spot) => <SpotCard spot={spot} />)}
    </div>
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-12 sm:py-16">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <SectionHeading
        eyebrow="To discover"
        title="Spotted for my next trip"
        description="My stop in Osaka was short and I haven't been able to try these places yet, but on paper they're worth the detour. I'll complete them with my photos and my review."
      />
      <div class="mt-10">
        <DiscoverList items={osakaDiscover} />
      </div>
    </div>
  </section>

  <AdSlot class="py-8 sm:py-12" />

  <section class="mx-auto max-w-8xl px-5 py-12 sm:py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="Where to park" title="Parking by neighborhood" />
        <div class="mt-8">
          <ParkingGrid items={osakaParking} />
        </div>
      </div>
      <div>
        <SectionHeading eyebrow="Tips" title="Make the most of it" />
        <div class="mt-8">
          <TipsList tips={osakaTips} />
        </div>
      </div>
    </div>
  </section>
</Layout>
