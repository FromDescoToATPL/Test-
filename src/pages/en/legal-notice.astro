---
import Layout from "../../layouts/Layout.astro";
import { CONTACT_EMAIL, HOST, SITE_NAME, withBase } from "../../consts";
---

<Layout title="Legal notice" description="Legal notice for the JDM Trip website.">
  <section class="mx-auto max-w-2xl px-5 py-12 sm:py-16 sm:px-8">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">Legal notice</h1>
    <p class="mt-4 font-body text-sm text-mist-500">
      This page translates the reference version, the <a href={withBase("/mentions-legales/")} class="link-underline text-ink">French legal notice</a>.
    </p>

    <div class="mt-10 space-y-8 font-body text-sm leading-relaxed text-ink-soft">
      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Site publisher</h2>
        <p class="mt-2">
          {SITE_NAME} is a personal website published by a private individual, on a non-professional basis. In
          accordance with French law (LCEN), the publisher has chosen to remain anonymous: their contact details have
          been provided to the site's hosting provider.
        </p>
        <p class="mt-2">
          Contact: <a href={`mailto:${CONTACT_EMAIL}`} class="link-underline font-medium text-racing-500">{CONTACT_EMAIL}</a>
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Hosting</h2>
        <p class="mt-2">
          {HOST.name}<br />
          {HOST.address}, {HOST.country.en}<br />
          {HOST.phone} · <a href={HOST.website} class="link-underline text-ink" target="_blank" rel="noopener noreferrer">vercel.com</a>
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Intellectual property</h2>
        <p class="mt-2">
          All content on {SITE_NAME} (text, photos, layout) is the property of the site publisher unless otherwise
          stated. The photos were taken by the author during their trips. Any reproduction without prior permission is
          prohibited.
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Advertising &amp; affiliate links</h2>
        <p class="mt-2">
          {SITE_NAME} currently has no advertising and no affiliate links. If that changes, this page will be updated,
          and those partnerships won't influence the objectivity of the reviews on the site.
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Limitation of liability</h2>
        <p class="mt-2">
          Practical information (addresses, prices, opening hours) is provided for guidance only and may change. Check
          important information (opening hours, rental conditions, regulations) with the businesses concerned before
          you go.
        </p>
      </div>
    </div>
  </section>
</Layout>
