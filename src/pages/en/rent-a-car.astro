---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SpotCard from "../../components/SpotCard.astro";
import AdSlot from "../../components/AdSlot.astro";
import heroImg from "../../assets/photos/tokyo-evo9-face-onlyjdm.jpg";
import { rentIntro, rentSpots, rentAdvice } from "../../data/en/rent-a-car";
---

<Layout
  title="Renting a car in Japan"
  description="Big chains, specialist agencies, insurance, International Driving Permit: everything you need to know before renting a car in Japan."
>
  <Hero
    image={heroImg}
    eyebrow="Practical guide"
    title="Renting a car in Japan"
    subtitle="From the train station to the enthusiast's garage: how to get behind the wheel without any bad surprises."
  />

  <section class="mx-auto max-w-3xl px-5 py-10 sm:py-14 sm:px-8">
    <p class="reveal whitespace-pre-line font-body text-lg leading-relaxed text-ink-soft">{rentIntro}</p>
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-12 sm:py-16">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <SectionHeading eyebrow="Where to go" title="Where to rent" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rentSpots.map((spot) => <SpotCard spot={spot} />)}
      </div>
    </div>
  </section>

  <AdSlot class="py-8 sm:py-12" />

  <section class="mx-auto max-w-3xl px-5 py-12 sm:py-16 sm:px-8">
    <SectionHeading eyebrow="Good to know" title="Before you take the keys" />
    <div class="mt-10 space-y-10">
      {rentAdvice.map((c) => (
        <div class="reveal border-l-2 border-racing-500 pl-6">
          <h3 class="font-display text-xl font-semibold text-ink">{c.title}</h3>
          <p class="mt-2 font-body text-sm leading-relaxed text-ink-soft">
            {c.text}
            {c.link && (
              <>
                {" "}
                <a href={c.link.href} class="link-underline font-medium text-racing-500">{c.link.label}</a>.
              </>
            )}
          </p>
        </div>
      ))}
    </div>
  </section>
</Layout>
