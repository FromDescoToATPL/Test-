---
// English version of src/pages/experiences/daikoku-tours-jdm.astro (adapted, not translated word for word).
// Clément hasn't been to Daikoku (weather): everything was checked online on 2026-11-04, sources in the FR file.
// Same layout as the FR page: one column, ~66 characters per line, each way of getting there ends with its
// "price + button" row (EncartReserver variante="ligne").
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Icon from "../../../components/Icon.astro";
import PageToc from "../../../components/PageToc.astro";
import ComparisonTable from "../../../components/ComparisonTable.astro";
import EncartReserver from "../../../components/EncartReserver.astro";
import MentionAffiliation from "../../../components/MentionAffiliation.astro";
import { withBase } from "../../../consts";
import heroImg from "../../../assets/photos/tokyo-nuit-rx7-veilside.jpg";

const pageOffers = [
  "onlyjdm-location",
  "daikoku-gyg-car-culture",
  "daikoku-gyg-tokyo-turismo",
  "daikoku-klook-nuit",
  "daikoku-klook-au-volant",
];
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Daikoku Futo Parking Area, Yokohama")}`;

const h2 = "reveal text-balance font-display text-2xl font-semibold text-ink sm:text-3xl";
const prose = "reveal mt-4 max-w-[66ch] space-y-4 font-body text-base leading-relaxed text-ink-soft";
const link = "link-underline font-medium text-racing-500";

// Passenger tours, from my top pick to the cheapest. Sources in the FR file.
const passengerTours = [
  {
    id: "daikoku-gyg-tokyo-turismo",
    title: "Tokyo Drift III, by Tokyo Turismo",
    facts: "GetYourGuide · 4.8/5 from 6,300+ reviews · 3 to 4 hours",
    text:
      "The most booked. You ride in a real sports car: their fleet includes R34 Skylines, R35 GT-Rs, Evos, a drift Chaser… Three or four people per car, and you can't pick which one, but they drop you back at your hotel in central Tokyo.",
  },
  {
    id: "daikoku-gyg-car-culture",
    title: "Daikoku and Tokyo Drift vibes",
    facts: "GetYourGuide · 4.8/5 from 725 reviews · 3 hours",
    text:
      "The cheapest. A small group of 10 people max, in a van or a sports car depending on the option, with a stop at A PIT Autobacs. In English.",
  },
  {
    id: "daikoku-klook-nuit",
    title: "JDM night tour with a local guide",
    facts: "Klook · 4.9/5 from 2,300+ reviews · 2.5 to 3 hours",
    text: "In a JDM car, with a standard or a VIP option.",
  },
];

const traps = [
  {
    title: "Closure nights",
    text: "On Friday and Saturday nights, keep the closures in mind and check your tour's plan B.",
  },
  {
    title: "Rain",
    text:
      "The operators say it themselves: the number of cars depends on the weather. On a rainy night, the lot can be nearly empty. I'm well placed to tell you about it…",
  },
  {
    title: "The fine print",
    text:
      "On the platforms, some very popular offers are actually a club membership: their terms state that the ride, the car and even the stop at Daikoku aren't guaranteed. Read the description all the way through before paying.",
  },
  {
    title: "Other people's cars",
    text:
      "No touching, no leaning, no sitting on them. For a close-up photo, ask the owner: most of them love to talk about their car.",
  },
  {
    title: "Your passport",
    text: "Operators ask for it, so keep it on you.",
  },
];

const faq = [
  {
    q: "Can you get to Daikoku by train or on foot?",
    a: "No. The parking area sits on the urban expressway, so you need a car: your own, a tour's, or a taxi. I wouldn't count on a taxi though: nothing guarantees you'll find one there to get back.",
  },
  {
    q: "Which night should you go to Daikoku?",
    a: "Weekends bring the most cars, but also the most closures, especially on Friday and Saturday nights. Weeknights are quieter: fewer people, but less risk of finding the entrance shut.",
  },
  {
    q: "How much does a Daikoku tour cost?",
    a: "From €71 as a passenger in a small group, around €120 to ride in a sports car, and from €467 to drive yourself. Prices checked on November 4, 2026.",
  },
  {
    q: "Do you need a license for a tour?",
    a: "Not as a passenger: your passport is enough. To drive, you need your physical license plus an International Driving Permit (1949 Geneva Convention) or an official Japanese translation, depending on your country. The self-drive tour I found also requires drivers to be 21 or older with 3 years of driving experience.",
  },
  {
    q: "What if Daikoku is closed?",
    a: "Tatsumi PA, closer to central Tokyo, and Umihotaru PA, out in the middle of the bay, are the usual fallbacks. The A PIT Autobacs store in Shinonome also stays open late. Good tours adapt on their own.",
  },
];

const practicalInfo = [
  { label: "Where", value: "A rest area on the Shuto urban expressway, in Yokohama (Tsurumi ward)" },
  { label: "Access", value: "By car only, free entry" },
  { label: "When", value: "In the evening, mostly on weekends, with no schedule or program" },
  { label: "Closures", value: "Frequent on Friday and Saturday nights, and when heavy snow is forecast" },
  { label: "Fallbacks", value: "Tatsumi PA, Umihotaru PA, A PIT Autobacs Shinonome" },
];
---

<Layout
  title="Daikoku PA: which JDM tour to book, or go on your own?"
  description="Daikoku PA can only be reached by car. Passenger tour, self-drive tour or rental: checked prices, weekend closures and my advice on how to choose."
  article={{ published: "2026-11-04" }}
  breadcrumbs={[
    { name: "Experiences", path: "/en/experiences/" },
    { name: "Daikoku PA", path: "/en/experiences/daikoku-jdm-tours/" },
  ]}
>
  <Hero
    image={heroImg}
    eyebrow="Experiences · Yokohama"
    title="Daikoku PA: go on your own or book a JDM tour?"
    subtitle="Japan's most famous car meet can only be reached by car. Here's how to choose."
    focalPoint="50% 62%"
  />

  <div class="mx-auto max-w-3xl space-y-12 px-5 pt-10 pb-12 sm:space-y-14 sm:px-8 sm:pt-14 sm:pb-16">
    <div>
      <a
        href={withBase("/en/experiences/")}
        class="tap-target link-underline reveal inline-flex items-center gap-1.5 font-body text-sm font-medium text-ink-soft"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        All experiences
      </a>

      <MentionAffiliation ids={pageOffers} class="mt-6" />

      <p class="reveal mt-8 max-w-[62ch] font-body text-lg leading-relaxed text-ink">
        Daikoku is the most famous highway parking lot in Japan. At night, enthusiasts park their JDM cars, supercars
        and wildest builds there, just to hang out and show off. The catch: you can only get in by car, from the urban
        expressway. If you're already renting a JDM, drive there yourself: it's the most freedom for the least money.
        Otherwise, a passenger tour is the easiest option, from around €70.
      </p>
      <p class="reveal mt-4 max-w-[66ch] font-body text-base leading-relaxed text-ink-soft">
        I'll be straight with you: I couldn't make it during my trip, the weather had other plans. So I did my homework
        for next time: operators' websites, conditions, travelers' reviews. Everything here was checked on November 4,
        2026.
      </p>
      <p class="reveal mt-3 font-body text-xs text-mist-500">
        In the photo: the Tokyo Drift VeilSide RX-7, spotted one night in Tokyo. Not at Daikoku, then.
      </p>

      <PageToc
        items={[
          { label: "Closures", href: "#closures" },
          { label: "Comparison", href: "#comparison" },
          { label: "Rental", href: "#rental" },
          { label: "Passenger", href: "#passenger" },
          { label: "Self-drive", href: "#self-drive" },
          { label: "Traps", href: "#traps" },
          { label: "FAQ", href: "#faq" },
        ]}
      />
    </div>

    <section id="what-is-it" class="scroll-mt-20">
      <h2 class={h2}>So what exactly is Daikoku?</h2>
      <div class={prose}>
        <p>
          Daikoku PA ("parking area") is a rest stop sitting in the middle of a huge interchange in Yokohama, on Tokyo's
          urban expressway, the Shuto. By day it's an ordinary stop: restrooms, a few shops, people passing through. At
          night, and especially on weekends, it's a different world. Skylines, Supras, RX-7s, Lamborghinis, bosozoku
          builds: everyone brings their best.
        </p>
        <p>
          One thing to get clear: it's not an event. No tickets, no schedule, no program. Some nights the lot is packed;
          others it rains and there's hardly anyone. That's part of the charm, and also why you should know what you're
          getting into before paying for a tour.
        </p>
      </div>
    </section>

    <section id="closures" class="scroll-mt-20">
      <div class="reveal rounded-lg border border-racing-500/30 bg-racing-500/5 p-5 sm:p-7">
        <h2 class="flex items-center gap-2.5 text-balance font-display text-xl font-semibold text-ink sm:text-2xl">
          <Icon name="flag" class="h-5 w-5 shrink-0 text-racing-500" />
          The catch: weekend closures
        </h2>
        <p class="mt-2 font-body text-base leading-relaxed text-ink-soft">This is what many people only find out on the spot.</p>
        <dl class="mt-4 divide-y divide-racing-500/15 border-t border-racing-500/15 font-body text-sm leading-relaxed">
          <div class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-5">
            <dt class="font-semibold text-ink">Friday and Saturday nights</dt>
            <dd class="text-ink-soft">
              When too many modified cars show up, the entrance is shut and everyone has to leave. According to the
              Japanese car press, it usually reopens between 1 and 3 a.m. One tour operator even says the lot is closed
              from 7:30 p.m. to 2 a.m. on those nights.
            </dd>
          </div>
          <div class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-5">
            <dt class="font-semibold text-ink">Heavy snow</dt>
            <dd class="text-ink-soft">
              The expressway operator closes the parking area when heavy snow is forecast: it then serves as a base for
              snow clearing.
            </dd>
          </div>
          <div class="grid gap-1 py-3.5 sm:grid-cols-[11rem_1fr] sm:gap-5">
            <dt class="font-semibold text-ink">Plan B</dt>
            <dd class="text-ink-soft">
              Don't panic: good tours have one, usually Tatsumi PA or the A PIT Autobacs store in Shinonome. Just check
              that yours does.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="comparison" class="scroll-mt-20">
      <h2 class={h2}>Three ways to get there</h2>
      <p class="reveal mt-4 max-w-[66ch] font-body text-base leading-relaxed text-ink-soft">
        It all comes down to one question: are you already renting a car during your stay?
      </p>
      <ComparisonTable
        class="mt-6"
        caption="Comparison of the three ways to get to Daikoku PA"
        rowHeader="How"
        columns={[
          { key: "price", label: "Price", emphasis: true },
          { key: "duration", label: "Duration" },
          { key: "role", label: "You are" },
          { key: "cancel", label: "Cancellation" },
        ]}
        rows={[
          {
            title: "With a rental",
            values: {
              price: "¥27,000 for 7 hours at OnlyJDM, plus fuel and tolls",
              duration: "7 or 24 hours",
              role: "The driver, free to roam",
              cancel: "Depends on the agency",
            },
          },
          {
            title: "Passenger tour",
            values: {
              price: "From €71",
              duration: "2.5 to 4 hours",
              role: "A passenger, in a small group or private",
              cancel: "Free up to 24 hours before on GetYourGuide",
            },
          },
          {
            title: "Self-drive tour",
            values: {
              price: "From €467",
              duration: "4 hours",
              role: "The driver, following a lead car",
              cancel: "Depends on the offer",
            },
          },
        ]}
        note="Prices checked on November 4, 2026: they vary with the date and the option you pick."
      />
    </section>

    <section id="rental" class="scroll-mt-20">
      <h2 class={h2}>Already renting a JDM? Go on your own</h2>
      <div class={prose}>
        <p>
          That's what I would have done with <a href={withBase("/en/tokyo/only-jdm/")} class={link}>my Evo VIII from OnlyJDM</a> if
          the sky had been kinder. Once you're behind the wheel, Daikoku is just an expressway exit: you show up when
          you want, stay as long as you want, and can hit Tatsumi or Umihotaru the same night.
        </p>
        <p>
          Three things to plan for: the license documents your country requires (no rental without them), ideally an
          ETC card for tolls, and a bit of patience to find a spot on busy nights. It's all covered on my <a href={withBase("/en/driving-in-japan/")} class={link}>Driving in Japan</a> page.
          And once there, keep it cool: no rev-limiter bouncing, no burnouts, park up and enjoy. That's also why the
          place still exists.
        </p>
      </div>
      <EncartReserver ids={["onlyjdm-location"]} variante="ligne" class="mt-6" />
    </section>

    <section id="passenger" class="scroll-mt-20">
      <h2 class={h2}>The easiest: a passenger tour</h2>
      <div class={prose}>
        <p>
          If you're not renting a car, this is the obvious choice. A guide takes you there, handles the driving and the
          tolls, and knows the fallbacks when Daikoku is closed. Three offers clearly stand out.
        </p>
        <p>
          If I were booking tomorrow for a first time, I'd go with Tokyo Turismo: rolling up to Daikoku in a GT-R is
          part of the dream. If budget matters, the €71 tour does the job very well for about €50 less.
        </p>
      </div>

      <div class="mt-6 divide-y divide-mist-200 border-y border-mist-200">
        {passengerTours.map((tour) => (
          <div class="py-6">
            <h3 class="reveal text-balance font-display text-xl font-semibold text-ink">{tour.title}</h3>
            <p class="reveal mt-1 font-body text-sm text-mist-500">{tour.facts}</p>
            <p class="reveal mt-3 max-w-[66ch] font-body text-base leading-relaxed text-ink-soft">{tour.text}</p>
            <EncartReserver ids={[tour.id]} variante="ligne" class="mt-4" />
          </div>
        ))}
      </div>
    </section>

    <section id="self-drive" class="scroll-mt-20">
      <h2 class={h2}>The wildest: drive a JDM to Daikoku yourself</h2>
      <div class={prose}>
        <p>
          On Klook, one offer puts you behind the wheel of a JDM for four hours, following a lead car: about 80 km, with
          a stop at A PIT Autobacs, the Daikoku meet, a run across the Rainbow Bridge and photos at Tokyo Tower. Fuel
          and tolls included.
        </p>
        <p>
          The rules are strict: 21 or older, 3 years of driving, and your physical license with your passport and an
          International Driving Permit (1949 Geneva Convention), or an official Japanese translation for the few
          countries that need one. No copies, no digital versions.
        </p>
        <p>
          It isn't cheap: from €467. For comparison, OnlyJDM rents the Evo VIII for ¥30,000 for 24 hours, and you keep
          the car all day. The real perk of the tour is not having to deal with the route or the parking.
        </p>
      </div>
      <EncartReserver ids={["daikoku-klook-au-volant"]} variante="ligne" class="mt-6" />
    </section>

    <section id="traps" class="scroll-mt-20">
      <h2 class={h2}>Traps to avoid</h2>
      <ul class="mt-5 space-y-5">
        {traps.map((t) => (
          <li class="reveal max-w-[66ch]">
            <p class="font-body text-base font-semibold text-ink">{t.title}</p>
            <p class="mt-1 font-body text-base leading-relaxed text-ink-soft">{t.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="faq" class="scroll-mt-20">
      <h2 class={h2}>FAQ</h2>
      <div class="reveal mt-5 divide-y divide-mist-200 border-y border-mist-200">
        {faq.map((item) => (
          <details class="group">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-ink transition-colors hover:text-racing-500 [&::-webkit-details-marker]:hidden">
              <h3 class="font-display text-lg font-semibold">{item.q}</h3>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-mist-500 transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <p class="max-w-[66ch] pb-5 font-body text-base leading-relaxed text-ink-soft">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="reveal rounded-lg border border-mist-200 bg-paper-dim/40 p-5 sm:p-6">
      <p class="eyebrow text-racing-500">Practical info</p>
      <p class="mt-2 font-display text-lg font-semibold text-ink">Daikoku PA</p>
      <dl class="mt-3 space-y-2 font-body text-sm leading-relaxed">
        {practicalInfo.map((info) => (
          <div class="grid grid-cols-[6.5rem_1fr] gap-3">
            <dt class="font-medium text-ink">{info.label}</dt>
            <dd class="text-ink-soft">{info.value}</dd>
          </div>
        ))}
      </dl>
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="tap-target link-underline mt-3 inline-flex items-center gap-1.5 font-body text-sm font-medium text-racing-500"
      >
        Open in Google Maps
        <Icon name="external-link" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-10 sm:py-14">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <p class="eyebrow text-mist-500">Read next</p>
      <ul class="mt-4 grid gap-x-8 sm:grid-cols-2">
        {[
          { label: "My Tokyo spots", href: withBase("/en/tokyo/") },
          { label: "Where to drive in Tokyo", href: withBase("/en/tokyo/where-to-drive/") },
          { label: "My OnlyJDM rental", href: withBase("/en/tokyo/only-jdm/") },
          { label: "Rent a JDM in Japan", href: withBase("/en/rent-a-car/") },
          { label: "Driving in Japan", href: withBase("/en/driving-in-japan/") },
          { label: "All experiences", href: withBase("/en/experiences/") },
        ].map((l) => (
          <li>
            <a href={l.href} class="link-underline inline-flex min-h-11 items-center gap-1.5 font-body text-sm font-medium text-ink">
              {l.label}
              <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
