---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SpotCard from "../../components/SpotCard.astro";
import ParkingGrid from "../../components/ParkingGrid.astro";
import TipsList from "../../components/TipsList.astro";
import Figure from "../../components/Figure.astro";
import AdSlot from "../../components/AdSlot.astro";

import heroImg from "../../assets/photos/fuji-musee-escaliers.jpg";
import corvetteInterieur from "../../assets/photos/fuji-corvette-interieur-pluie.jpg";
import lemans from "../../assets/photos/fuji-musee-lemans-787b-gtone.jpg";

import { fujiIntro, fujiSpots, fujiParking, fujiTips } from "../../data/en/mont-fuji";

const locationSpots = fujiSpots.filter((s) => s.category === "location");
const otherSpots = fujiSpots.filter((s) => s.category !== "location");
---

<Layout
  title="Mount Fuji"
  description="Sports car rental, the Fuji Speedway race track and a motorsports museum: the car enthusiast's guide to the Kawaguchiko area."
>
  <Hero
    image={heroImg}
    eyebrow="Destination"
    title="Mount Fuji & Kawaguchiko"
    subtitle="Between the lake and the mountain, 35 minutes from a historic race track and a museum that's worth the trip on its own."
  />

  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8">
    <p class="reveal font-body text-lg leading-relaxed text-ink-soft">{fujiIntro}</p>
  </section>

  <section class="mx-auto max-w-8xl px-5 py-16 sm:px-8">
    <SectionHeading eyebrow="Car rental" title="Behind the wheel at Fuji" />
    <div class="mt-10 grid gap-6 lg:grid-cols-3 lg:items-start">
      {locationSpots.map((spot) => <SpotCard spot={spot} />)}
      <Figure
        image={corvetteInterieur}
        alt="View from inside a Corvette C7 in the rain, on a mountain road near Mount Fuji"
        caption="Rain, fog, climbing roads: driving at the foot of Mount Fuji is an experience in itself, even (especially) when the mountain is hiding."
        class="lg:col-span-2"
        aspectClass="aspect-[16/9]"
      />
    </div>
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-20">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <SectionHeading
        eyebrow="35 minutes away"
        title="Race track and motorsports museum"
        description="The two places not to miss if you rent a car around Kawaguchiko."
      />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {otherSpots.map((spot) => <SpotCard spot={spot} />)}
      </div>
      <Figure
        image={lemans}
        alt="Mazda 787B and Toyota GT-One displayed side by side in a motorsports museum near Fuji Speedway"
        caption="The Mazda 787B (winner of the 1991 24 Hours of Le Mans) next to the Toyota GT-One, in one of the museum's halls."
        class="mx-auto mt-10 max-w-3xl"
      />
    </div>
  </section>

  <AdSlot class="py-16" />

  <section class="mx-auto max-w-8xl px-5 py-20 sm:px-8">
    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Where to park" title="Parking around the lake" />
        <div class="mt-8">
          <ParkingGrid items={fujiParking} />
        </div>
      </div>
      <div>
        <SectionHeading eyebrow="Tips" title="Make the most of it" />
        <div class="mt-8">
          <TipsList tips={fujiTips} />
        </div>
      </div>
    </div>
  </section>
</Layout>
