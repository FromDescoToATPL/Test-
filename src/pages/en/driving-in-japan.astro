---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import AdSlot from "../../components/AdSlot.astro";
import Icon from "../../components/Icon.astro";
import heroImg from "../../assets/photos/fuji-corvette-interieur-pluie.jpg";
import { drivingIntro, drivingSections } from "../../data/en/driving-in-japan";
---

<Layout
  title="Driving in Japan"
  description="International Driving Permit or license translation, ETC tolls, parking, fuel: the complete guide to getting behind the wheel in Japan with confidence."
>
  <Hero
    image={heroImg}
    eyebrow="Practical guide"
    title="Driving in Japan"
    subtitle="Everything to prepare before getting behind the wheel: from your license to the rental agency."
  />

  <section class="mx-auto max-w-3xl px-5 py-10 sm:py-14 sm:px-8">
    <p class="reveal whitespace-pre-line font-body text-lg leading-relaxed text-ink-soft">{drivingIntro}</p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-12 sm:pb-16 sm:px-8">
    <div class="space-y-16">
      {drivingSections.map((section, i) => (
        <>
          <div class="reveal">
            <p class="eyebrow text-racing-500">{section.eyebrow}</p>
            <h2 class="mt-2 font-display text-2xl font-semibold text-ink sm:text-3xl">{section.title}</h2>
            {section.note && (
              <p class="mt-4 rounded-lg border border-racing-500/30 bg-racing-500/5 p-4 font-body text-sm leading-relaxed text-ink-soft sm:p-5">
                {section.note}
              </p>
            )}
            <div class="mt-4 space-y-3">
              {section.paragraphs.map((p) => (
                <p class="font-body text-sm leading-relaxed text-ink-soft">{p}</p>
              ))}
            </div>
            {section.bullets && (
              <ul class="mt-4 space-y-2 border-l-2 border-mist-200 pl-5">
                {section.bullets.map((b) => (
                  <li class="font-body text-sm leading-relaxed text-ink-soft">{b}</li>
                ))}
              </ul>
            )}
            {section.moreInfo && (
              <a
                href={section.moreInfo.href}
                class="link-underline mt-5 inline-flex items-center gap-1.5 font-body text-sm font-medium text-ink"
              >
                {section.moreInfo.label}
                <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            )}
            {section.optionsIntro && (
              <div class="mt-8">
                <p class="font-body text-sm leading-relaxed text-ink-soft">{section.optionsIntro}</p>
                {section.optionsLink && (
                  <a
                    href={section.optionsLink.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline mt-1 inline-block font-body text-sm font-medium text-racing-500"
                  >
                    {section.optionsLink.label}
                  </a>
                )}
              </div>
            )}
            {section.options && (
              <div class="mt-6 space-y-6">
                {section.options.map((opt) => (
                  <div class="rounded-lg border border-mist-200 bg-paper-dim/40 p-5">
                    <div class="flex flex-wrap items-center gap-2.5">
                      <h3 class="font-display text-lg font-semibold text-ink">{opt.title}</h3>
                      <span class={`rounded-full px-2.5 py-0.5 font-body text-[11px] font-medium ${opt.badge === "Hard" ? "bg-racing-500/10 text-racing-600" : "bg-gold-400/25 text-gold-700"}`}>
                        {opt.badge}
                      </span>
                    </div>
                    <div class="mt-3 space-y-3">
                      {opt.paragraphs.map((p) => (
                        <p class="font-body text-sm leading-relaxed text-ink-soft">{p}</p>
                      ))}
                    </div>
                    {opt.link && (
                      <a
                        href={opt.link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-underline mt-3 inline-block font-body text-sm font-medium text-racing-500"
                      >
                        {opt.link.label}
                      </a>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
          {i === 2 && <AdSlot />}
        </>
      ))}
    </div>
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-10 sm:py-14">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <SectionHeading
        align="center"
        eyebrow="Coming soon"
        title="This page will keep growing"
        description="Stories, surprising road signs, favorite routes: the next updates will come straight from the road."
      />
    </div>
  </section>
</Layout>
