---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import { withBase } from "../../consts";
import heroImg from "../../assets/photos/tokyo-evo9-arriere-onlyjdm.jpg";
---

<Layout
  title="Only JDM"
  description="Only JDM à Tokyo : un garage/atelier spécialisé qui vaut le détour pour tout passionné — adresse et avis complets à venir."
>
  <Hero
    image={heroImg}
    eyebrow="Bonne adresse — Tokyo"
    title="Only JDM"
    subtitle="Un garage/atelier spécialisé JDM repéré à Tokyo, aileron imposant et échappement titane sans complexe."
  />

  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <a
      href={withBase("/tokyo/")}
      class="link-underline reveal inline-flex items-center gap-1.5 font-body text-sm font-medium text-ink-soft"
    >
      <Icon name="arrow-left" class="h-3.5 w-3.5" />
      Retour à Tokyo
    </a>

    <p class="reveal mt-8 font-body text-lg leading-relaxed text-ink-soft">
      Repéré pendant le séjour : un garage/atelier spécialisé JDM où trônait cette Lancer Evolution IX gris
      argent aux côtés d'une GT-R. Le genre d'adresse qui vaut le détour pour n'importe quel passionné de
      passage à Tokyo.
    </p>
    <p class="reveal mt-4 rounded-md border border-dashed border-mist-300 bg-paper-dim/40 px-4 py-3 font-body text-sm text-mist-500">
      Page en cours de complétion — adresse exacte, horaires et avis détaillé de Clément à venir.
    </p>
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-16">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <a
        href={withBase("/tokyo/")}
        class="link-underline reveal inline-flex items-center gap-1.5 font-body text-sm font-medium text-ink"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        Retour à toutes les adresses de Tokyo
      </a>
    </div>
  </section>
</Layout>
