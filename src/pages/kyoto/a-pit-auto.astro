---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Figure from "../../components/Figure.astro";
import Icon from "../../components/Icon.astro";
import AdSlot from "../../components/AdSlot.astro";
import { withBase } from "../../consts";
import heroImg from "../../assets/photos/kyoto-apit-auto-interieur.jpg";
import volantsImg from "../../assets/photos/kyoto-apit-auto-mur-volants.jpg";
import miniaturesImg from "../../assets/photos/kyoto-apit-auto-miniatures-livres.jpg";
---

<Layout
  title="A-PIT Auto Kyoto"
  description="A-PIT Auto Kyoto : pièces et préparation, univers Liberty Walk, miniatures et vêtements. Le repaire JDM incontournable du Kansai."
>
  <Hero
    image={heroImg}
    eyebrow="Bonne adresse · Kyoto"
    title="A-PIT Auto Kyoto"
    subtitle="Un immense hangar dédié à la passion automobile japonaise, aux portes du Kansai : pièces, préparation, vêtements et miniatures, jusqu'à un Starbucks sur place."
  />

  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <a
      href={withBase("/kyoto/")}
      class="link-underline reveal inline-flex items-center gap-1.5 font-body text-sm font-medium text-ink-soft"
    >
      <Icon name="arrow-left" class="h-3.5 w-3.5" />
      Retour à Kyoto
    </a>

    <p class="reveal mt-8 font-body text-lg leading-relaxed text-ink-soft">
      A-PIT Auto, c'est le genre d'adresse qui revient systématiquement dans la bouche des amateurs de JDM en
      visite dans la région du Kansai. Sous une verrière parcourue de guirlandes lumineuses, le magasin déploie
      plusieurs étages dédiés aux pièces, à la préparation, au vêtement et aux miniatures, avec, au milieu des
      rayons, un Starbucks pour la pause.
    </p>
    <p class="reveal mt-4 rounded-md border border-dashed border-mist-300 bg-paper-dim/40 px-4 py-3 font-body text-sm text-mist-500">
      Page en cours de complétion : adresse exacte, horaires et avis détaillé de Clément à venir.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16 sm:px-8">
    <h2 class="reveal font-display text-2xl font-semibold text-ink">Le rayon préparation</h2>
    <p class="reveal mt-4 font-body text-sm leading-relaxed text-ink-soft">
      Le mur ne fait pas semblant : échappements et suspensions signés VIITS (la marque maison développée avec
      HKS) et BLITZ, avec tout un programme de préparation dédié à l'Abarth 595. Kits carrosserie, dampers,
      débitmètres : de quoi repartir avec un peu plus qu'un souvenir si tu roules dans le coin.
    </p>
    <Figure
      image={volantsImg}
      alt="Mur de volants NARDI, OMP et Prodrive chez A-PIT Auto Kyoto"
      caption="Le mur des volants : NARDI, OMP, Prodrive et quelques éditions limitées."
      class="reveal mt-6"
      aspectClass="aspect-[16/9]"
    />
  </section>

  <AdSlot class="py-8" />

  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <h2 class="reveal font-display text-2xl font-semibold text-ink">Miniatures, livres et goodies</h2>
    <p class="reveal mt-4 font-body text-sm leading-relaxed text-ink-soft">
      À l'étage, des rangées entières de miniatures au 1/43 et de livres collector, jusqu'à une collection
      dédiée aux voitures de la saga Fast & Furious (ワイルドスピード en version japonaise). De quoi repartir
      avec autre chose qu'un aimant de frigo, si les pièces détachées ne sont pas ta priorité du jour.
    </p>
    <Figure
      image={miniaturesImg}
      alt="Rayonnages de voitures miniatures et de livres collector chez A-PIT Auto Kyoto"
      caption="Une partie du rayon miniatures et livres collector."
      class="reveal mt-6"
      aspectClass="aspect-[16/9]"
    />
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-16">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <a
        href={withBase("/kyoto/")}
        class="link-underline reveal inline-flex items-center gap-1.5 font-body text-sm font-medium text-ink"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        Retour à toutes les adresses de Kyoto
      </a>
    </div>
  </section>
</Layout>
