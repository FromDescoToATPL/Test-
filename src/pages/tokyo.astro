---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SpotCard from "../components/SpotCard.astro";
import ParkingGrid from "../components/ParkingGrid.astro";
import TipsList from "../components/TipsList.astro";
import Figure from "../components/Figure.astro";
import AdSlot from "../components/AdSlot.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../consts";
import evoFace from "../assets/photos/tokyo-evo9-face-onlyjdm.jpg";
import heroImg from "../assets/photos/tokyo-shibuya-crossing-nuit.jpg";
import galleryR34 from "../assets/photos/tokyo-nuit-r34-nismo.jpg";
import galleryRx7 from "../assets/photos/tokyo-nuit-rx7-veilside.jpg";
import galleryR33 from "../assets/photos/tokyo-nuit-r33-akihabara.jpg";
import galleryWidebody from "../assets/photos/tokyo-nuit-widebody-akihabara.jpg";
import gallerySkylineCoupe from "../assets/photos/tokyo-nuit-skyline-coupe-shibuya.jpg";
import gallery86 from "../assets/photos/tokyo-nuit-86.jpg";
import { tokyoIntro, tokyoSpots, tokyoParking, tokyoTips } from "../data/tokyo";

const streetGallery = [
  {
    image: galleryR34,
    alt: "Nissan Skyline R34 bleue, phares allumés, dans une rue de Tokyo la nuit",
    caption: "Une Skyline R34, toujours aussi culte.",
  },
  {
    image: galleryRx7,
    alt: "Mazda RX-7 FD Veilside orange et noire dans une rue de Tokyo la nuit",
    caption: "Une RX-7 FD Veilside, impossible de la manquer.",
  },
  {
    image: galleryR33,
    alt: "Nissan Skyline R33 stancée sous la pluie à Akihabara",
    caption: "Une Skyline R33 stancée sous la pluie, à Akihabara.",
  },
  {
    image: galleryWidebody,
    alt: "Coupé japonais widebody noir sous la pluie à Akihabara",
    caption: "Une compacte widebody croisée sous la pluie, à Akihabara.",
  },
  {
    image: gallerySkylineCoupe,
    alt: "Nissan Skyline coupé blanc stancé dans le trafic de nuit à Shibuya",
    caption: "Une Skyline coupé dans le trafic de Shibuya.",
  },
  {
    image: gallery86,
    alt: "Toyota 86 blanche garée dans une rue de Tokyo la nuit",
    caption: "Une 86 croisée en pleine rue.",
  },
];
---

<Layout
  title="Tokyo"
  description="Garages JDM, rendez-vous nocturnes et stationnement : le guide du passionné d'automobile à Tokyo."
>
  <Hero
    image={heroImg}
    eyebrow="Destination"
    title="Tokyo"
    subtitle="La mégapole où la passion automobile s'exhibe à ciel ouvert, des avenues de Roppongi aux garages de quartier."
    compact
  />

  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8">
    <p class="reveal font-body text-lg leading-relaxed text-ink-soft">{tokyoIntro}</p>
  </section>

  <section class="mx-auto max-w-8xl px-5 pb-20 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <Figure
        image={evoFace}
        alt="Mitsubishi Lancer Evolution IX que j'ai louée à Tokyo"
      />
      <div class="reveal">
        <p class="eyebrow text-racing-500">Rencontre</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink sm:text-3xl">
          Une Evo IX de chez OnlyJDM pour la journée
        </h2>
        <p class="mt-4 font-body text-sm leading-relaxed text-ink-soft">
          Voici l'Evo 9 GSR préparée que j'ai récupérée de cette agence. Adresse, prix, caution, disponibilité : tout savoir dans l'article !
        </p>
        <a
          href={withBase("/tokyo/only-jdm/")}
          class="link-underline mt-4 inline-flex w-fit items-center gap-1.5 font-body text-sm font-medium text-racing-500"
        >
          Lire l'article
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-8xl px-5 pb-20 sm:px-8">
    <SectionHeading eyebrow="Ambiance" title="Repérées dans les rues de Tokyo" />
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
      {streetGallery.map((photo) => (
        <Figure
          image={photo.image}
          alt={photo.alt}
          caption={photo.caption}
          class="text-center"
          aspectClass="aspect-[3/4]"
        />
      ))}
    </div>
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-20">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <SectionHeading eyebrow="Bonnes adresses" title="Garages, ateliers & rendez-vous" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tokyoSpots.map((spot) => <SpotCard spot={spot} />)}
      </div>
    </div>
  </section>

  <AdSlot class="py-16" />

  <section class="mx-auto max-w-8xl px-5 py-20 sm:px-8">
    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Où se garer" title="Stationnement par quartier" />
        <div class="mt-8">
          <ParkingGrid items={tokyoParking} />
        </div>
      </div>
      <div>
        <SectionHeading eyebrow="Conseils" title="Pour en profiter au maximum" />
        <div class="mt-8">
          <TipsList tips={tokyoTips} />
        </div>
      </div>
    </div>
  </section>
</Layout>
