---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SpotCard from "../components/SpotCard.astro";
import AdSlot from "../components/AdSlot.astro";
import heroImg from "../assets/photos/tokyo-evo9-face-onlyjdm.jpg";
import { louerIntro, louerSpots, louerConseils } from "../data/louer-une-voiture";
---

<Layout
  title="Louer une voiture au Japon"
  description="Grandes enseignes, agences spécialisées, assurance, permis international : tout ce qu'il faut savoir avant de louer une voiture au Japon."
>
  <Hero
    image={heroImg}
    eyebrow="Guide pratique"
    title="Louer une voiture au Japon"
    subtitle="De la gare au garage de passionnés : comment prendre le volant sans mauvaise surprise."
  />

  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <p class="reveal whitespace-pre-line font-body text-lg leading-relaxed text-ink-soft">{louerIntro}</p>
  </section>

  <section class="border-t border-mist-200 bg-paper-dim/50 py-20">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <SectionHeading eyebrow="Bonnes adresses" title="Où louer" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {louerSpots.map((spot) => <SpotCard spot={spot} />)}
      </div>
    </div>
  </section>

  <AdSlot class="py-16" />

  <section class="mx-auto max-w-3xl px-5 py-20 sm:px-8">
    <SectionHeading eyebrow="Ce qu'il faut savoir" title="Avant de prendre les clés" />
    <div class="mt-10 space-y-10">
      {louerConseils.map((c) => (
        <div class="reveal border-l-2 border-racing-500 pl-6">
          <h3 class="font-display text-xl font-semibold text-ink">{c.titre}</h3>
          <p class="mt-2 font-body text-sm leading-relaxed text-ink-soft">
            {c.texte}
            {c.link && (
              <>
                {" "}
                <a href={c.link.href} class="link-underline font-medium text-racing-500">{c.link.label}</a>.
              </>
            )}
          </p>
        </div>
      ))}
    </div>
  </section>
</Layout>
