---
import Icon from "./Icon.astro";
import { SITE_NAME, withBase } from "../consts";
import { LANGS, getLang, translatePath, ui } from "../i18n";

const lang = getLang(Astro.url);
const t = ui[lang];
const homeHref = withBase(lang === "en" ? "/en/" : "/");
const langOptions = LANGS.map((l) => ({
  lang: l,
  href: translatePath(Astro.url, l),
  active: l === lang,
}));

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-mist-200/80 bg-paper/97 backdrop-blur-sm">
  <div class="mx-auto flex max-w-8xl items-center justify-between px-5 py-4 sm:px-8">
    <a
      href={homeHref}
      class="font-display text-xl font-semibold tracking-tight text-ink"
      aria-label={t.homeLabel}
    >
      {SITE_NAME}
    </a>

    <div class="flex items-center gap-2 lg:gap-8">
      <nav class="hidden items-center gap-8 lg:flex" aria-label={t.mainNav}>
        <div class="group relative">
          <button
            class="eyebrow flex items-center gap-1 text-ink-soft transition-colors hover:text-ink cursor-pointer"
            aria-haspopup="true"
            aria-expanded="false"
            id="destinations-trigger"
          >
            {t.destinations}
            <Icon name="chevron-down" class="h-3.5 w-3.5 transition-transform group-focus-within:rotate-180" />
          </button>
          <div
            id="destinations-menu"
            class="invisible absolute left-0 top-full flex w-56 flex-col gap-1 rounded-md border border-mist-200 bg-paper p-2 opacity-0 shadow-lg transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
          >
            {t.destinationLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "rounded-sm px-3 py-2 font-body text-sm transition-colors hover:bg-paper-dim",
                  isActive(link.href) ? "text-racing-500 font-medium" : "text-ink",
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        {t.mainNavLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "eyebrow link-underline transition-colors hover:text-ink",
              isActive(link.href) ? "text-racing-500" : "text-ink-soft",
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center rounded-full border border-mist-200 p-0.5" role="group" aria-label={t.language}>
        {langOptions.map((option) => (
          <a
            href={option.href}
            hreflang={option.lang}
            lang={option.lang}
            aria-label={t.langNames[option.lang]}
            aria-current={option.active ? "true" : undefined}
            class:list={[
              "eyebrow rounded-full px-3 py-1.5 text-[11px] transition-colors",
              option.active ? "bg-ink text-paper" : "text-ink-soft hover:text-ink",
            ]}
          >
            {option.lang.toUpperCase()}
          </a>
        ))}
      </div>

      <button
        id="mobile-menu-button"
        class="menu-button relative flex h-11 w-11 items-center justify-center rounded-sm text-ink lg:hidden cursor-pointer"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
      >
        <span class="menu-icon menu-icon-open"><Icon name="menu" class="h-6 w-6" /></span>
        <span class="menu-icon menu-icon-close"><Icon name="close" class="h-6 w-6" /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu lg:hidden" data-open="false">
    <div class="mobile-menu-backdrop" data-menu-close></div>
    <nav
      class="mobile-menu-panel flex flex-col gap-1 overflow-y-auto border-l border-mist-200 bg-paper px-5 py-4"
      aria-label={t.mainNav}
    >
      <p class="menu-item eyebrow px-2 pb-1 pt-2 text-mist-500" style="--i: 0">{t.destinations}</p>
      {t.destinationLinks.map((link, i) => (
        <a
          href={link.href}
          style={`--i: ${i + 1}`}
          class:list={[
            "menu-item rounded-sm px-2 py-2.5 font-body text-base",
            isActive(link.href) ? "text-racing-500 font-medium" : "text-ink",
          ]}
        >
          {link.label}
        </a>
      ))}
      <div class="menu-item my-2 h-px bg-mist-200" style={`--i: ${t.destinationLinks.length + 1}`}></div>
      {t.mainNavLinks.map((link, i) => (
        <a
          href={link.href}
          style={`--i: ${t.destinationLinks.length + 2 + i}`}
          class:list={[
            "menu-item rounded-sm px-2 py-2.5 font-body text-base",
            isActive(link.href) ? "text-racing-500 font-medium" : "text-ink",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Menu mobile : un tiroir glisse depuis la droite sous le header, par-dessus
     la page (rien n'est poussé vers le bas), et les liens arrivent en cascade. */
  .mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 1px);
    height: calc(100dvh - var(--header-h, 77px));
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s linear var(--duration-base);
  }
  .mobile-menu[data-open="true"] {
    visibility: visible;
    transition: visibility 0s;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-ink) 45%, transparent);
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }
  .mobile-menu[data-open="true"] .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(20rem, 85vw);
    box-shadow: -16px 0 40px -20px color-mix(in srgb, var(--color-ink) 40%, transparent);
    transform: translateX(100%);
    transition: transform var(--duration-base) var(--ease-out-soft);
  }
  .mobile-menu[data-open="true"] .mobile-menu-panel {
    transform: none;
    transition-duration: var(--duration-slow);
  }

  .menu-item {
    opacity: 0;
    transform: translateX(12px);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }
  .mobile-menu[data-open="true"] .menu-item {
    opacity: 1;
    transform: none;
    transition:
      opacity 350ms ease,
      transform 450ms var(--ease-out-soft);
    transition-delay: calc(80ms + var(--i) * 35ms);
  }

  /* Burger ↔ croix : fondu avec un quart de tour. */
  .menu-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-base) var(--ease-out-soft);
  }
  .menu-icon-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
  }
  .menu-button[aria-expanded="true"] .menu-icon-open {
    opacity: 0;
    transform: rotate(90deg) scale(0.8);
  }
  .menu-button[aria-expanded="true"] .menu-icon-close {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu[data-open="true"] .menu-item {
      transition-delay: 0s;
    }
  }
</style>

<script>
  const header = document.querySelector("header");
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const isOpen = () => menu?.getAttribute("data-open") === "true";

  const setOpen = (open: boolean) => {
    if (!menu || !button) return;
    if (open && header) menu.style.setProperty("--header-h", `${header.offsetHeight}px`);
    menu.setAttribute("data-open", String(open));
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? "");
    // La page ne défile pas derrière le tiroir.
    document.documentElement.style.overflow = open ? "hidden" : "";
  };

  button?.addEventListener("click", () => setOpen(!isOpen()));
  menu?.querySelector("[data-menu-close]")?.addEventListener("click", () => setOpen(false));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
      button?.focus();
    }
  });

  // Passage en affichage bureau (rotation d'une tablette) : on referme.
  matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
    if (event.matches && isOpen()) setOpen(false);
  });

  // Retour arrière depuis le cache du navigateur : la page revient menu fermé.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted && isOpen()) setOpen(false);
  });
</script>
