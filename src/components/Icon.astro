  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
  "arrow-right": '<path d="M4 12h16"/><path d="M13 5l7 7-7 7"/>',
  "chevron-down": '<path d="M6 9l6 6 6-6"/>',
  "shopping-bag":
    '<path d="M6 8h12l1 12.2a1.8 1.8 0 0 1-1.8 1.8H6.8A1.8 1.8 0 0 1 5 20.2L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  building:
    '<path d="M4 21V6l8-3 8 3v15"/><path d="M4 21h16"/><path d="M9 9h.01M15 9h.01M9 13h.01M15 13h.01M9 17h.01M15 17h.01"/>',
  parking:
