---
interface Props {
  name:
    | "map-pin"
    | "car"
    | "tag"
    | "external-link"
    | "menu"
    | "close"
    | "arrow-right"
    | "chevron-down"
    | "shopping-bag"
    | "building"
    | "parking"
    | "flag"
    | "steering-wheel"
    | "instagram";
