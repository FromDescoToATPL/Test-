---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image?: ImageMetadata;
  eyebrow: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
  /** Point de la photo à garder visible, format CSS object-position (ex. "30% 40%"). Défaut : centré. */
  focalPoint?: string;
  /** Zoom appliqué autour du focalPoint (1 = pas de zoom). */
  zoom?: number;
  /** Dégradé renforcé derrière le texte, pour les photos très colorées (ex. livrée de la 787B sur l'accueil). */
  strongShade?: boolean;
}
const { image, eyebrow, title, subtitle, compact = false, focalPoint = "50% 50%", zoom = 1, strongShade = false } = Astro.props;
---

<section
  class:list={[
    "relative flex items-end overflow-hidden bg-asphalt",
    compact ? "min-h-[42vh]" : "min-h-[64vh]",
  ]}
>
  {image ? (
    <>
      <Image
        src={image}
        alt=""
        role="presentation"
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${focalPoint}; transform: scale(${zoom}); transform-origin: ${focalPoint};`}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div
        class:list={[
          "absolute inset-0 bg-gradient-to-t from-asphalt to-asphalt/10",
          strongShade ? "via-asphalt/65" : "via-asphalt/40",
        ]}
      ></div>
      <div
        class:list={[
          "absolute inset-0 bg-gradient-to-r to-transparent",
          strongShade ? "from-asphalt/90 via-asphalt/45" : "from-asphalt/60 via-transparent",
        ]}
      ></div>
    </>
  ) : (
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse at 20% 20%, rgba(196,59,78,0.18), transparent 55%), radial-gradient(ellipse at 85% 75%, rgba(217,182,92,0.12), transparent 50%), #0B0B0C;"
    >
      <svg class="absolute inset-0 h-full w-full opacity-[0.07]" aria-hidden="true">
        <defs>
          <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M48 0H0V48" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)"/>
      </svg>
    </div>
  )}

  <div class="relative mx-auto w-full max-w-8xl px-5 pb-12 pt-24 sm:px-8 sm:pb-16">
    <p class="eyebrow text-gold-400">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold text-paper sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    {subtitle && <p class="mt-4 max-w-xl font-body text-base text-mist-200 sm:text-lg">{subtitle}</p>}
  </div>
</section>
