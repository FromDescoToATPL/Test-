---
import Icon from "./Icon.astro";
import type { ParkingTip } from "../data/types";

interface Props {
  items: ParkingTip[];
}
const { items } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((item) => (
    <div class="reveal rounded-lg border border-mist-200 bg-paper p-5">
      <div class="flex items-center gap-2 text-ink">
        <Icon name="parking" class="h-4 w-4 text-racing-500" />
        <h3 class="font-display text-base font-semibold">{item.area}</h3>
      </div>
      <p class="mt-2 font-body text-sm leading-relaxed text-ink-soft">{item.advice}</p>
    </div>
  ))}
</div>
