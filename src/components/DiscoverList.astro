---
// Liste sobre des adresses repérées mais pas encore testées par Clément.
// La section qui l'affiche le dit une seule fois dans son intro : pas de badge carte par carte.
import Icon from "./Icon.astro";
import type { Spot } from "../data/types";
import { categoryIcon } from "../data/categories";
import { useUi } from "../i18n";

interface Props {
  items: Spot[];
}
const { items } = Astro.props;
const t = useUi(Astro.url).spot;

const mapsHref = (query: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
---

<div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((item) => (
    <div class="reveal border-t border-mist-200 pt-5">
      <p class="eyebrow flex items-center gap-2 text-racing-500">
        <Icon name={categoryIcon[item.category]} class="h-3.5 w-3.5" />
        {t.categories[item.category]}
      </p>
      <h3 class="mt-2 font-display text-lg font-semibold text-ink">{item.name}</h3>
      {item.area && (
        <p class="mt-1 flex items-center gap-1.5 font-body text-sm text-mist-500">
          <Icon name="map-pin" class="h-3.5 w-3.5 shrink-0" />
          {item.area}
        </p>
      )}
      <p class="mt-2 font-body text-sm leading-relaxed text-ink-soft">{item.description}</p>
      {item.tip && <p class="mt-2 font-body text-xs leading-relaxed text-mist-500">{item.tip}</p>}
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
        {item.mapsQuery && (
          <a
            href={mapsHref(item.mapsQuery)}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center gap-1.5 font-body text-sm font-medium text-racing-500"
          >
            {t.openMaps}
            <Icon name="external-link" class="h-3.5 w-3.5" />
          </a>
        )}
        {item.website && (
          <a
            href={item.website}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center gap-1.5 font-body text-sm font-medium text-racing-500"
          >
            {t.website}
            <Icon name="external-link" class="h-3.5 w-3.5" />
          </a>
        )}
      </div>
    </div>
  ))}
</div>
