---
import { SITE_NAME } from "../consts";
import { useUi } from "../i18n";

const t = useUi(Astro.url);
const year = new Date().getFullYear();
---

<footer class="border-t border-mist-200 bg-asphalt text-paper">
  <div class="mx-auto max-w-8xl px-5 py-10 sm:px-8 sm:py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="font-display text-2xl font-semibold">{SITE_NAME}</p>
        <p class="mt-3 max-w-sm font-body text-sm text-mist-300">{t.tagline}</p>
      </div>

      <div>
        <p class="eyebrow text-mist-400">{t.destinations}</p>
        <ul class="mt-4 space-y-2.5">
          {t.destinationLinks.map((link) => (
            <li>
              <a href={link.href} class="tap-target link-underline font-body text-sm text-mist-200 hover:text-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow text-mist-400">{t.guides}</p>
        <ul class="mt-4 space-y-2.5">
          {t.mainNavLinks.map((link) => (
            <li>
              <a href={link.href} class="tap-target link-underline font-body text-sm text-mist-200 hover:text-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-body text-xs text-mist-400">
        © {year} {SITE_NAME}. {t.rights}
      </p>
      <div class="flex gap-5 font-body text-xs text-mist-400">
        <a href={t.legalLink.href} class="tap-target hover:text-paper">{t.legalLink.label}</a>
        <a href={t.privacyLink.href} class="tap-target hover:text-paper">{t.privacyLink.label}</a>
      </div>
    </div>
  </div>
</footer>
