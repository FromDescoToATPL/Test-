---
import { SITE_NAME, SITE_TAGLINE, destinationLinks, mainNavLinks, withBase } from "../consts";
const year = new Date().getFullYear();
---

<footer class="border-t border-mist-200 bg-asphalt text-paper">
  <div class="mx-auto max-w-8xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="font-display text-2xl font-semibold">{SITE_NAME}</p>
        <p class="mt-3 max-w-sm font-body text-sm text-mist-300">{SITE_TAGLINE}</p>
      </div>

      <div>
        <p class="eyebrow text-mist-400">Destinations</p>
        <ul class="mt-4 space-y-2.5">
          {destinationLinks.map((link) => (
            <li>
              <a href={link.href} class="link-underline font-body text-sm text-mist-200 hover:text-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow text-mist-400">Guides</p>
        <ul class="mt-4 space-y-2.5">
          {mainNavLinks.map((link) => (
            <li>
              <a href={link.href} class="link-underline font-body text-sm text-mist-200 hover:text-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-body text-xs text-mist-400">
        © {year} {SITE_NAME}. Tous droits réservés.
      </p>
      <div class="flex gap-5 font-body text-xs text-mist-400">
        <a href={withBase("/mentions-legales/")} class="hover:text-paper">Mentions légales</a>
        <a href={withBase("/confidentialite/")} class="hover:text-paper">Confidentialité &amp; cookies</a>
      </div>
    </div>
  </div>
</footer>
