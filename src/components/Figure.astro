---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  /** Contraint l'image à un ratio fixe (ex. "aspect-[3/4]") pour aligner plusieurs photos entre elles. Sans ça, l'image garde sa hauteur naturelle. */
  aspectClass?: string;
}
const { image, alt, caption, class: className = "", aspectClass = "" } = Astro.props;
---

<figure class:list={["reveal", className]}>
  <div class:list={["overflow-hidden rounded-lg", aspectClass]}>
    <Image
      src={image}
      alt={alt}
      class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-[1.03]"
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading="lazy"
    />
  </div>
  {caption && <figcaption class="mt-2 font-body text-xs text-mist-500">{caption}</figcaption>}
</figure>
