---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}
const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class:list={["reveal max-w-3xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && <p class="eyebrow text-racing-500">{eyebrow}</p>}
  <h2 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 whitespace-pre-line font-body text-base leading-relaxed text-ink-soft">{description}</p>}
</div>
