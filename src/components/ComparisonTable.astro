---
// Tableau comparatif des articles : un vrai tableau à partir de la tablette, une fiche par ligne sur mobile.
interface Props {
  caption: string;
  /** Intitulé de la première colonne (ex. « Façon d'y aller »). */
  rowHeader: string;
  columns: { key: string; label: string; emphasis?: boolean }[];
  rows: { title: string; values: Record<string, string> }[];
  note?: string;
  class?: string;
}
const { caption, rowHeader, columns, rows, note, class: className = "" } = Astro.props;
---

<div class:list={["reveal", className]}>
  <div class="hidden overflow-hidden rounded-lg border border-mist-200 bg-paper md:block">
    <table class="w-full border-collapse text-left font-body text-sm leading-relaxed">
      <caption class="sr-only">{caption}</caption>
      <thead class="bg-paper-dim/60">
        <tr>
          <th scope="col" class="px-4 py-3 font-meta text-xs font-medium uppercase tracking-[0.12em] text-mist-500">{rowHeader}</th>
          {columns.map((c) => (
            <th scope="col" class="px-4 py-3 font-meta text-xs font-medium uppercase tracking-[0.12em] text-mist-500">{c.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-t border-mist-200 align-top">
            <th scope="row" class="px-4 py-3.5 font-display text-base font-semibold text-ink">{r.title}</th>
            {columns.map((c) => (
              <td class:list={["px-4 py-3.5", c.emphasis ? "font-semibold tabular-nums text-ink" : "text-ink-soft"]}>
                {r.values[c.key]}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="grid gap-4 md:hidden">
    {rows.map((r) => (
      <div class="rounded-lg border border-mist-200 bg-paper p-5">
        <p class="font-display text-lg font-semibold text-ink">{r.title}</p>
        <dl class="mt-3 divide-y divide-mist-200 font-body text-sm leading-relaxed">
          {columns.map((c) => (
            <div class="grid grid-cols-[7rem_1fr] gap-3 py-2">
              <dt class="pt-0.5 font-meta text-[0.6875rem] font-medium uppercase tracking-[0.12em] text-mist-500">{c.label}</dt>
              <dd class:list={[c.emphasis ? "font-semibold tabular-nums text-ink" : "text-ink-soft"]}>{r.values[c.key]}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>

  {note && <p class="mt-3 font-body text-xs leading-relaxed text-mist-500">{note}</p>}
</div>
