---
// Encart « Réserver » : une carte par offre (1 à 3 maximum), à placer juste après le passage qui la recommande.
// Les offres viennent de src/data/offres.ts. Un vrai lien affilié porte rel="sponsored" ; un lien public
// (offre encore en A_REMPLIR) reste un lien normal.
import Icon from "./Icon.astro";
import { getOffre, estAffilie, lienOffre, type Plateforme } from "../data/offres";
import { getLang } from "../i18n";

interface Props {
  ids: string[];
  /**
   * "cartes" (par défaut) : une carte par offre, avec titre et description.
   * "ligne" : seulement le prix et le bouton, à placer juste sous le texte qui présente déjà l'offre.
   */
  variante?: "cartes" | "ligne";
  class?: string;
}
const { ids, variante = "cartes", class: className = "" } = Astro.props;
const lang = getLang(Astro.url);
const items = ids.map(getOffre);

const t = {
  fr: {
    eyebrow: "Réserver",
    from: "À partir de",
    checked: "vérifié le",
    priceChecked: "Prix vérifié le",
    // Libellés courts : ils doivent tenir sur une ligne dans un bouton pleine largeur sur mobile.
    cta: {
      getyourguide: "Voir les dates sur GetYourGuide",
      klook: "Voir les dates sur Klook",
      viator: "Voir les dates sur Viator",
      direct: "Voir le site de l'agence",
    },
  },
  en: {
    eyebrow: "Book",
    from: "From",
    checked: "checked on",
    priceChecked: "Price checked on",
    cta: {
      getyourguide: "See dates on GetYourGuide",
      klook: "See dates on Klook",
      viator: "See dates on Viator",
      direct: "Visit the agency's website",
    },
  },
}[lang] satisfies { cta: Record<Plateforme, string> } & Record<string, unknown>;

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString(lang === "fr" ? "fr-FR" : "en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
const ctaClass =
  "inline-flex min-h-11 items-center gap-2 rounded-md bg-ink px-4 py-2.5 font-body text-sm font-medium text-paper transition-colors hover:bg-racing-600";
---

{variante === "ligne" ? (
  <div class:list={["reveal space-y-3", className]}>
    {items.map((offre) => (
      <div class="flex flex-col gap-3 rounded-lg border border-mist-200 bg-paper-dim/40 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-3 sm:pr-3 sm:pl-5">
        <p class="font-body text-sm text-ink-soft">
          {offre.prixIndicatif ? (
            <>
              {t.from} <strong class="text-base font-semibold tabular-nums text-ink">{offre.prixIndicatif[lang]}</strong>
              {offre.dateVerif && (
                <span class="block text-xs text-mist-500">
                  {t.priceChecked} {formatDate(offre.dateVerif)}
                </span>
              )}
            </>
          ) : (
            <strong class="font-semibold text-ink">{offre.titre[lang]}</strong>
          )}
        </p>
        <a
          href={lienOffre(offre, lang)}
          target="_blank"
          rel={estAffilie(offre) ? "sponsored noopener" : "noopener noreferrer"}
          class:list={[ctaClass, "w-full shrink-0 justify-center sm:w-auto"]}
        >
          {offre.libelleBouton?.[lang] ?? t.cta[offre.plateforme]}
          <span class="sr-only">({offre.titre[lang]})</span>
          <Icon name="external-link" class="h-3.5 w-3.5 shrink-0" />
        </a>
      </div>
    ))}
  </div>
) : (
<aside class:list={["reveal", className]} aria-label={t.eyebrow}>
  <p class="eyebrow flex items-center gap-2 text-racing-500">
    <Icon name="tag" class="h-3.5 w-3.5" />
    {t.eyebrow}
  </p>
  <div class:list={["mt-3 grid gap-4", items.length > 1 && "sm:grid-cols-2", items.length > 2 && "lg:grid-cols-3"]}>
    {items.map((offre) => (
      <article class="flex flex-col rounded-lg border border-mist-200 bg-paper p-5 shadow-sm sm:p-6">
        <h3 class="font-display text-lg font-semibold text-ink">{offre.titre[lang]}</h3>
        <p class="mt-1.5 font-body text-sm leading-relaxed text-ink-soft">{offre.description[lang]}</p>
        {offre.prixIndicatif && (
          <p class="mt-3 font-body text-sm text-ink">
            {t.from} <strong class="font-semibold tabular-nums">{offre.prixIndicatif[lang]}</strong>
            {offre.dateVerif && <span class="text-xs text-mist-500"> · {t.checked} {formatDate(offre.dateVerif)}</span>}
          </p>
        )}
        <div class="mt-auto pt-5">
          <a
            href={lienOffre(offre, lang)}
            target="_blank"
            rel={estAffilie(offre) ? "sponsored noopener" : "noopener noreferrer"}
            class={ctaClass}
          >
            {offre.libelleBouton?.[lang] ?? t.cta[offre.plateforme]}
            <Icon name="external-link" class="h-3.5 w-3.5 shrink-0" />
          </a>
        </div>
      </article>
    ))}
  </div>
</aside>
)}
